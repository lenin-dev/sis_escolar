generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id_usuario      String            @id @default(uuid())
  nombre_completo String            @db.VarChar(50)
  usuario         String            @db.VarChar(50)
  contrasena      String            @db.VarChar(100)
  correo          String?           @db.VarChar(50)
  activo          Boolean           @db.TinyInt
  fecha_creacion  DateTime          @db.Timestamp(0)
  usuario_funcion Usuario_Funcion[]
}

model Funciones {
  id_funcion      Int               @id @default(autoincrement())
  nombre_funcion  String            @db.VarChar(50)
  descripcion     String?           @db.VarChar(100)
  fecha_creacion  DateTime          @db.Timestamp(0)
  funcion_funcion Usuario_Funcion[]
}

model Usuario_Funcion {
  id_usu_fun       Int       @id @default(autoincrement())
  id_usuario       String
  id_funcion       Int
  fecha_asignacion DateTime  @db.Timestamp(0)
  idfuncion        Funciones @relation(fields: [id_funcion], references: [id_funcion])
  idusuario        Usuario   @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_funcion], map: "Usuario_Funcion_id_funcion_fkey")
  @@index([id_usuario], map: "Usuario_Funcion_id_usuario_fkey")
}
